generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  USER
}

enum ShipmentStatus {
  NEW
  PROCESSING
  RECEIVED
  IN_TRANSIT
  ARRIVED
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
  RETURNED
  ISSUE
}

enum FinancialStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  REVERSED
  SETTLED
}

enum CustomerType {
  TEMPORARY
  REGISTERED
}

enum CustomerLifecycle {
  NEW
  ACTIVE
  REPEAT
  INACTIVE
}

enum MerchantVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  CANCEL
  REVERSE
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
  VERIFY
  MERGE
  ARCHIVE
}


model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  status UserStatus @default(ACTIVE)
  role UserRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?
  shipments Shipment[] @relation("ShipmentCreator")
  payments Payment[]
  auditLogs AuditLog[]
}

model Customer {
  id String @id @default(cuid())
  name String
  businessName String?
  phone String
  additionalPhone String?
  wilaya String?
  commune String?
  niche String?
  address String?
  type CustomerType @default(TEMPORARY)
  lifecycle CustomerLifecycle @default(NEW)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shipments Shipment[]
  debts Debt[]
  payments Payment[]
  @@index([phone])
  @@index([businessName])
}

model Merchant {
  id String @id @default(cuid())
  name String
  businessName String?
  phone String
  additionalPhone String?
  wilaya String
  commune String
  category String?
  niche String
  address String?
  description String?
  verificationStatus MerchantVerificationStatus @default(UNVERIFIED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([phone])
  @@index([niche,wilaya,commune])
}

model Shipment {
  id String @id @default(cuid())
  reference String @unique
  serialNumber String @unique
  customerId String?
  senderName String
  senderPhone String?
  recipientName String
  recipientPhone String?
  originWilaya String
  originCommune String?
  destinationWilaya String
  destinationCommune String?
  description String
  quantity Int @default(1)
  weight Decimal?
  volume Decimal?
  deliveryFee Decimal @db.Decimal(12,2)
  financialStatus FinancialStatus @default(UNPAID)
  status ShipmentStatus @default(NEW)
  createdByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer? @relation(fields:[customerId],references:[id])
  createdBy User? @relation("ShipmentCreator",fields:[createdByUserId],references:[id])
  statusHistory ShipmentStatusHistory[]
  payments Payment[]
  debt Debt?
  @@index([status,createdAt])
  @@index([destinationWilaya,status])
}

model ShipmentStatusHistory {
  id String @id @default(cuid())
  shipmentId String
  fromStatus ShipmentStatus?
  toStatus ShipmentStatus
  reason String?
  changedByUserId String?
  createdAt DateTime @default(now())
  shipment Shipment @relation(fields:[shipmentId],references:[id],onDelete:Cascade)
  @@index([shipmentId,createdAt])
}

model Payment {
  id String @id @default(cuid())
  reference String @unique
  shipmentId String?
  customerId String?
  amount Decimal @db.Decimal(12,2)
  method String
  type String
  status String @default("VALID")
  createdByUserId String
  createdAt DateTime @default(now())
  shipment Shipment? @relation(fields:[shipmentId],references:[id])
  customer Customer? @relation(fields:[customerId],references:[id])
  createdBy User @relation(fields:[createdByUserId],references:[id])
}

model Debt {
  id String @id @default(cuid())
  customerId String
  shipmentId String? @unique
  originalAmount Decimal @db.Decimal(12,2)
  settledAmount Decimal @default(0) @db.Decimal(12,2)
  status String @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields:[customerId],references:[id])
  shipment Shipment? @relation(fields:[shipmentId],references:[id])
  @@index([customerId,status])
}

model CashAccount {
  id String @id @default(cuid())
  name String
  currency String @default("DZD")
  createdAt DateTime @default(now())
  entries CashLedgerEntry[]
}

model CashLedgerEntry {
  id String @id @default(cuid())
  cashAccountId String
  type String
  amount Decimal @db.Decimal(12,2)
  direction String
  referenceType String?
  referenceId String?
  reason String?
  createdAt DateTime @default(now())
  cashAccount CashAccount @relation(fields:[cashAccountId],references:[id])
  @@index([cashAccountId,createdAt])
}

model Expense {
  id String @id @default(cuid())
  reference String @unique
  category String
  amount Decimal @db.Decimal(12,2)
  paymentMethod String
  beneficiary String?
  description String?
  createdByUserId String
  createdAt DateTime @default(now())
}

model Partner {
  id String @id @default(cuid())
  name String
  phone String?
  percentage Decimal @db.Decimal(5,2)
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  settlements PartnerSettlement[]
}

model PartnerSettlement {
  id String @id @default(cuid())
  partnerId String
  periodStart DateTime
  periodEnd DateTime
  distributableProfit Decimal @db.Decimal(12,2)
  percentage Decimal @db.Decimal(5,2)
  calculatedShare Decimal @db.Decimal(12,2)
  paidAmount Decimal @default(0) @db.Decimal(12,2)
  remainingAmount Decimal @default(0) @db.Decimal(12,2)
  partner Partner @relation(fields:[partnerId],references:[id])
}

model AuditLog {
  id String @id @default(cuid())
  actorUserId String?
  action AuditAction
  entityType String
  entityId String
  beforeData Json?
  afterData Json?
  reason String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  actor User? @relation(fields:[actorUserId],references:[id])
  @@index([entityType,entityId,createdAt])
}